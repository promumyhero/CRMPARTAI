# PostgreSQL Database Connection URL
# Ubah kredensial sesuai database PostgreSQL lokal / Neon / Supabase Anda
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crmforu

# Secret key untuk signing JWT Multi-User Auth
AUTH_SECRET=crmforu_super_secret_jwt_key_32chars_min_length_2026

# Base URL aplikasi
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
